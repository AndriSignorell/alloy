if (requireNamespace("survival", quietly = TRUE)) {
  fitCox <- fitMod(Surv(foltime, folstatus) ~ gender, Whas100,
                   fitfn = "coxph")
  head(predict(fitCox))

  # Parametric survival - expected survival time
  fitWei <- fitMod(Surv(foltime, folstatus) ~ gender + age, Whas100,
                   fitfn = "weibull")
